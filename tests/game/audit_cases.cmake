# cmake -DIN=<p3fes_handgen pair-test skeleton> -DOUT=<inc> -P audit_cases.cmake
# Cuts the recomp_gen declarations and the kCases table out of the skeleton (tests/game/audit_faithful.cmake): from
# "namespace p3fes::recomp_gen {" to the end of "const Case kCases[] = {...};", closing the anonymous namespace it opens.
file(READ ${IN} _s)
string(FIND "${_s}" "namespace p3fes::recomp_gen {" _a)
string(FIND "${_s}" "};\n\n// The world" _b)
if(_a LESS 0 OR _b LESS 0)
    message(FATAL_ERROR "audit_cases.cmake: ${IN} does not look like a p3fes_handgen skeleton")
endif()
math(EXPR _n "${_b} + 2 - ${_a}")
string(SUBSTRING "${_s}" ${_a} ${_n} _cut)
file(WRITE ${OUT} "// Generated by tests/game/audit_cases.cmake from p3fes_handgen's skeleton: every function of game/replaced.txt.\n${_cut}\n\n}  // namespace\n")
